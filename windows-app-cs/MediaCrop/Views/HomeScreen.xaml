<UserControl x:Class="MediaCrop.Views.HomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F0F"
             AllowDrop="True"
             DragEnter="OnDragEnter"
             Drop="OnDrop">

    <Grid>
        <!-- Centered card -->
        <Border Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#262626"
                CornerRadius="20"
                Padding="32">
            <StackPanel>

                <TextBlock Text="Media Crop"
                           HorizontalAlignment="Center"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#F5F5F5"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Crop · Trim · Export"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Foreground="#9CA3AF"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Drop a video here, or"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#9CA3AF"
                           Margin="0,0,0,12"/>

                <Button Content="Pick Video File…"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnPickFile"
                        Margin="0,0,0,20"/>

                <!-- Divider -->
                <Border Height="1" Background="#3a3a3a" Margin="0,0,0,20"/>

                <!-- Default start time -->
                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock Text="Default start time (ms)"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               DockPanel.Dock="Left"/>
                    <TextBox x:Name="StartTimeTxt"
                             Width="110"
                             DockPanel.Dock="Right"
                             TextChanged="StartTimeTxt_TextChanged"
                             HorizontalContentAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="When a video loads, the IN point starts here.&#10;Useful for skipping a camera intro every time."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <TextBlock x:Name="StatusLabel"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#EF4444"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
