<UserControl x:Class="MediaCrop.Controls.TrimControlsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:MediaCrop.Controls">

    <StackPanel Margin="12,8,12,8">

        <!-- Position label -->
        <TextBlock x:Name="PosLabel"
                   Text="▶  00:00.000"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="#9CA3AF"
                   Margin="0,0,0,4"/>

        <!-- Seek slider -->
        <Slider x:Name="SeekSlider"
                Minimum="0" Maximum="1000"
                Margin="0,0,0,6"
                ValueChanged="SeekSlider_ValueChanged"/>

        <!-- Range slider (two-handle) -->
        <ctrl:RangeSliderControl x:Name="RangeSlider" Margin="0,0,0,4"/>

        <!-- IN / Duration / OUT labels -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="InLabel"  Grid.Column="0" Text="00:00.000"
                       FontFamily="Consolas" FontSize="11" Foreground="#6366F1"/>
            <TextBlock x:Name="DurLabel" Grid.Column="2" Text="00:00.000"
                       FontFamily="Consolas" FontSize="11" Foreground="#9CA3AF"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="OutLabel" Grid.Column="4" Text="00:00.000"
                       FontFamily="Consolas" FontSize="11" Foreground="#6366F1"/>
        </Grid>

        <!-- PLAY row -->
        <ctrl:AdjustRow x:Name="PlayRow" Margin="0,2"/>
        <!-- IN row -->
        <ctrl:AdjustRow x:Name="InRow"   Margin="0,2"/>
        <!-- OUT row -->
        <ctrl:AdjustRow x:Name="OutRow"  Margin="0,2"/>

        <!-- Clip duration -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Duration" Grid.Column="0"
                       FontSize="12" Foreground="#9CA3AF"/>
            <TextBlock x:Name="ClipDurLabel" Grid.Column="1"
                       FontFamily="Consolas" FontSize="12" Foreground="#06B6D4"/>
        </Grid>

    </StackPanel>
</UserControl>
