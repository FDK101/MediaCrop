<UserControl x:Class="MediaCrop.Controls.AdjustRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="38">
    <Border Background="#262626" CornerRadius="10">
        <Grid Margin="10,4,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="38"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LabelText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#9CA3AF"/>

            <TextBlock x:Name="TimeText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="13"
                       Foreground="#F5F5F5"/>

            <Button x:Name="BtnM1s"  Grid.Column="2" Content="-1s"  Style="{StaticResource AdjustButton}" Click="BtnM1s_Click"  Margin="2,0"/>
            <Button x:Name="BtnM100" Grid.Column="3" Content="-100" Style="{StaticResource AdjustButton}" Click="BtnM100_Click" Margin="2,0"/>
            <Button x:Name="BtnM1"   Grid.Column="4" Content="-1"   Style="{StaticResource AdjustButton}" Click="BtnM1_Click"   Margin="2,0"/>
            <Button x:Name="BtnP1"   Grid.Column="5" Content="+1"   Style="{StaticResource AdjustButton}" Click="BtnP1_Click"   Margin="2,0"/>
            <Button x:Name="BtnP100" Grid.Column="6" Content="+100" Style="{StaticResource AdjustButton}" Click="BtnP100_Click" Margin="2,0"/>
            <Button x:Name="BtnP1s"  Grid.Column="7" Content="+1s"  Style="{StaticResource AdjustButton}" Click="BtnP1s_Click"  Margin="2,0"/>
        </Grid>
    </Border>
</UserControl>
